# Website → WhatsApp bot integration (site root par ye file .env me daalo)
# Dev me agar set nahi ho to http://localhost:3001 auto-use hota hai.
# Deploy ke baad public bot URL daalo, e.g. https://mrmrsmasala-bot.onrender.com
VITE_BOT_API_URL=

# NOTE (deploy ke baad): bot URL cross-origin hoga — vercel.json aur
# public/_headers me CSP `connect-src 'self'` me us URL ko add karna
# (warna browser order forward block karega).

# ---------------------------------------------------------------------------
# Online payment (Razorpay) — frontend ke liye optional
# ---------------------------------------------------------------------------
# Sirf local testing ke liye. `npm run dev` me Vercel ke /api functions nahi
# chalte, isliye dev me apni deployed site ka URL daal do (taaki payment test
# ho sake). Khaali chhodo to same-origin /api/* use hoga (Vercel par sahi hai).
VITE_PAYMENTS_API_URL=

# ---------------------------------------------------------------------------
# Razorpay (online payment)
# ---------------------------------------------------------------------------
# Ye dono SIRF server-side hain (VITE_ prefix NAHI lagana).
# Local dev: isi file ko `.env` me copy karo.
# Vercel: Project → Settings → Environment Variables me daalo
#         (Production + Preview + Development, dono ke liye).
#
# Keys yahan se milti hain: https://dashboard.razorpay.com/app/keys
# Test mode me `rzp_test_...` aur live mode me `rzp_live_...` keys hoti hain.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
